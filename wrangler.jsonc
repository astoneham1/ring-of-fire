{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ring-of-fire",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Everything else is the React app, served straight from the assets.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The home page goes through the Worker too, to personalise link previews for invite links.
    "run_worker_first": ["/ws/*", "/"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // SQLite-backed Durable Objects are the kind available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
