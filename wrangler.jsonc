{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ring-of-fire",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Everything except the game socket and API is the React app.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // SQLite-backed Durable Objects are the kind available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
